<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background — solid deep background matching app theme.
  Must be a <shape> or <vector>; this uses a plain <shape> rectangle
  which AAPT handles without issue.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0D1117" />
</shape>
