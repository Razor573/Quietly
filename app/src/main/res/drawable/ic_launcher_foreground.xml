<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — a simple "Q" lettermark on a transparent background.
  Uses <vector> (not <shape>) so AAPT can compile it correctly.
  Safe zone: keep artwork inside the inner 66dp circle (108dp canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer circle of the "Q" -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28
            A26,26 0 1 1 53.999,28 Z
            M54,28
            m-18,18
            a18,18 0 1 0 36,0
            a18,18 0 1 0 -36,0" />

    <!-- Clean ring: outer circle minus inner circle -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,32 A22,22 0 1 0 54.001,32 Z
                          M54,40 A14,14 0 1 1 54.001,40 Z" />

    <!-- Tail of the Q -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M63,63 L70,72" />
</vector>
